{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "bionlife-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        "dist-bionlife",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "url": "http://bionlife.localhost:4173"
    }
  ]
}
