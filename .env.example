# Chaves do Web3Forms. Copie este arquivo para .env.local e preencha os valores.
# Nota: chaves com prefixo VITE_ ficam visíveis no bundle do navegador. O Web3Forms
# foi projetado assim (a chave é um endereço de entrega, não um segredo), mas ainda
# vale mantê-las fora do código-fonte para poder trocá-las sem recompilar.

VITE_WEB3FORMS_KEY_CONTATO=
VITE_WEB3FORMS_KEY_CONSULTOR=
VITE_WEB3FORMS_KEY_FITACADEMIA=

# Supabase (loja + afiliados). A anon key e publica; o RLS protege os dados.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
